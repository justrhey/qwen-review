{
  "name": "qwen-review",
  "private": true,
  "description": "Arko Workspace: local code review, live implementation, frontend preview and a native desktop app",
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build:ui": "esbuild workspace/code-ui-src.js --bundle --minify --outfile=workspace/code-ui.js --format=iife",
